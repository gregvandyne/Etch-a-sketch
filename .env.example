# ——— Public (safe to expose to the browser) ———

# The site's canonical URL. Used for metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://courtneystockton.com

# Sanity project. Create at sanity.io → new project, then paste the values here.
# Until these are set, the site runs in preview mode with labeled sample content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-06-01

# Privacy-friendly analytics (optional). Set to the site's domain to enable
# Plausible; leave empty to disable analytics entirely.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ——— Server-only secrets (never exposed to the browser, never committed) ———

# Sanity "Viewer" token — powers the Studio's Preview tab (draft preview).
# Create in sanity.io/manage → API → Tokens (Viewer permissions).
SANITY_API_READ_TOKEN=

# Sanity "Editor" token — needed ONLY to run the one-time image migration
# (npm run migrate:images). Safe to remove after migrating.
SANITY_API_WRITE_TOKEN=

# Any random string; also entered in the Sanity webhook settings so publishes
# refresh the site automatically. Generate with: openssl rand -hex 16
SANITY_REVALIDATE_SECRET=

# Instagram feed (optional). When both are set, the homepage shows the
# latest Instagram photographs, refreshed hourly. Requires an Instagram
# Graph API long-lived access token for the professional account
# @courtney_stockton; see docs/TECHNICAL.md ("Instagram feed") for setup
# and the 60-day token-refresh requirement.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# Inquiry-form email delivery via Resend (resend.com).
RESEND_API_KEY=
# Where inquiries are delivered:
INQUIRY_TO_EMAIL=courtney@courtneystockton.com
# The verified sender, e.g. "Website <inquiries@courtneystockton.com>":
INQUIRY_FROM_EMAIL=
